#!/usr/bin/env bash
# vibe-spec-intake — Weapon 1.
#
# Socratic decomposition of a one-line intent into atomic Acceptance Criteria.
# Reads a feature slug + 1-line intent, asks the developer to confirm/refine
# each proposed AC, then writes `docs/requirements/<slug>/spec.md` with
# Status: awaiting-approval.
#
# Two modes:
#   --interactive (default for humans): walks the developer through each AC.
#   --auto (for /vibe-spec or scripts): generates ACs from a template, no Q&A.
#
# Usage:
#   vibe-spec-intake [--ai] <slug> "<1-line intent>"
#   vibe-spec-intake [--ai] --auto <slug> "<1-line intent>"
#   cat intent.txt | vibe-spec-intake [--ai] --stdin <slug>
#
# Output: a markdown spec with Goal, ACs (atomic, one test each), Constraints,
#         Non-Goals, Edge Cases. Status: awaiting-approval.

set -uo pipefail

die() { echo "vibe-spec-intake: $*" >&2; exit 4; }

SLUG=""
INTENT=""
MODE="interactive"
USE_AI=0

while [ $# -gt 0 ]; do
  case "$1" in
    --auto) MODE="auto"; shift ;;
    --stdin) MODE="stdin"; shift ;;
    --ai) USE_AI=1; shift ;;
    -h|--help)
      sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) [ -z "$SLUG" ] && SLUG="$1" || INTENT="$1"; shift ;;
  esac
done

[ -z "$SLUG" ] && die "usage: vibe-spec-intake <slug> \"<1-line intent>\""

# If --stdin, read intent from stdin.
if [ "$MODE" = "stdin" ]; then
  INTENT="$(cat)"
fi

# Sanitize slug: lowercase, dashes only.
SLUG="$(printf '%s' "$SLUG" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+|-+$//g')"
[ -z "$SLUG" ] && die "invalid slug"
[ -z "$INTENT" ] && die "no intent provided (use --stdin or pass as 2nd arg)"

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT" 2>/dev/null || die "no project root"
SPEC_DIR="$PROJECT_ROOT/docs/requirements/$SLUG"
SPEC="$SPEC_DIR/spec.md"

if [ -e "$SPEC" ]; then
  echo "vibe-spec-intake: $SPEC already exists."
  echo "  edit it directly, or delete it and re-run."
  exit 1
fi

mkdir -p "$SPEC_DIR"

generate_ai() {
  if ! command -v claude >/dev/null 2>&1; then
    echo "vibe-spec-intake: AI not available, falling back" >&2
    return 1
  fi
  local prompt_tmpl
  # Resolve prompt template relative to this script (kit-owned, not project-owned).
  local script_dir
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  # Walk up to find kit root (script_dir/../prompts or wherever prompts live).
  local kit_root
  kit_root="$(cd "$script_dir/.." && pwd)"
  prompt_tmpl="$kit_root/prompts/spec-intake.md"
  if [ ! -f "$prompt_tmpl" ]; then
    echo "vibe-spec-intake: prompt template missing, falling back" >&2
    return 1
  fi
  local today
  today="$(date -u +%Y-%m-%d)"
  
  local prompt_file
  prompt_file="$(mktemp -t vibe-intake-prompt.XXXXXX)"
  
  awk -v intent="$INTENT" -v slug="$SLUG" -v date="$today" '
    {
      gsub(/\{\{INTENT\}\}/, intent)
      gsub(/\{\{SLUG\}\}/, slug)
      gsub(/\{\{DATE\}\}/, date)
      print
    }
  ' "$prompt_tmpl" > "$prompt_file"
  
  local out_file
  out_file="$(mktemp -t vibe-intake-out.XXXXXX)"
  
  echo "vibe-spec-intake: invoking AI (this costs tokens)..." >&2
  
  if ! claude --print "$(cat "$prompt_file")" > "$out_file" 2>/dev/null; then
    echo "vibe-spec-intake: AI invocation failed, falling back" >&2
    rm -f "$prompt_file" "$out_file"
    return 1
  fi
  
  local ai_out
  ai_out="$(cat "$out_file")"
  rm -f "$prompt_file" "$out_file"
  
  if [ -z "$ai_out" ]; then
    echo "vibe-spec-intake: AI output was empty, falling back" >&2
    return 1
  fi
  
  local intent_kws
  intent_kws="$(printf '%s' "$INTENT" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '\n' | awk 'length($0) >= 4' | head -5 | paste -sd '|' -)"
  if [ -n "$intent_kws" ]; then
    if ! printf '%s' "$ai_out" | grep -qiE "($intent_kws)"; then
      echo "vibe-spec-intake: AI output failed validation, falling back" >&2
      return 1
    fi
  fi
  
  printf '%s\n' "$ai_out"
  return 0
}

generate_template() {
  local today
  today="$(date -u +%Y-%m-%d)"
  cat <<TMPL
# $SLUG

* **Status:** awaiting-approval
* **Date:** $today

## Goal

$INTENT

## Acceptance Criteria

Each AC is one test. The Coder writes the test, then the implementation.

- AC1. <describe the primary happy-path behavior>
- AC2. <describe the most important error path>
- AC3. <describe at least one edge case the AI would otherwise miss>
- AC4. <describe the constraint that keeps this from breaking other features>
- AC5. <describe what this feature does NOT do — see Non-Goals>

## Constraints

- <what the Coder must NOT do>

## Non-Goals

- <what this feature is explicitly NOT>

## Edge Cases

- <list 2-3 failure modes you've thought about>

## Verification

For each AC, fill in a \`Verification:\` block:

\`\`\`
- AC1. <description>
  Verification:
    automated test: tests/<file>.py::test_<name>
    expected behavior: <one-line>
\`\`\`
TMPL
}

if [ "$USE_AI" -eq 1 ]; then
  if generate_ai > "$SPEC"; then
    if [ "$MODE" = "interactive" ]; then
      cat >&2 <<EOF
Generated AI-assisted Spec at $SPEC.

Next steps:
  1. Open $SPEC
  2. Review the AI's ACs and Constraints
  3. Edit anything that doesn't match what you meant
  4. Run: /vibe-spec $SLUG --review

When the Spec is what you actually want, flip Status to \`in-progress\`.
EOF
      echo "  ✓ wrote $SPEC"
      exit 0
    else
      echo "$SPEC"
      exit 0
    fi
  fi
fi

if [ "$MODE" = "interactive" ]; then
  cat >&2 <<EOF
Generating a Spec template at $SPEC.

The template is dumb on purpose. Your job is to fill in the real ACs.

Next steps:
  1. Open $SPEC
  2. Replace each AC stub with a real, testable behavior
  3. Add Edge Cases you don't want the AI to miss
  4. Run: /vibe-spec $SLUG --review

When the Spec is what you actually want, flip Status to \`in-progress\`.
The Coder will start implementing AC1.
EOF
  generate_template > "$SPEC"
  echo "  ✓ wrote $SPEC"
  exit 0
fi

# --auto mode: still write the template (the developer must review).
generate_template > "$SPEC"
echo "$SPEC"
