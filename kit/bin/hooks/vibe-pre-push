#!/usr/bin/env bash
# vibe-pre-push — opt-in git pre-push hook that runs vibe-claim-check.
#
# Installed by `kit/bin/vibe-install` (default), or manually with:
#   cp kit/bin/hooks/vibe-pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Behavior:
#   - Runs `vibe-claim-check` on every push. Claim-check is the **ship gate**:
#     it demands per-AC evidence (test path + diff) AND runs the project's tests.
#     The Coder can't claim "done" without showing the work AC by AC.
#   - Exits non-zero if claim-check exits non-zero (i.e. PARTIAL or FAIL).
#   - VIBE_SHIP_OVERRIDE=1 lifts BLOCK (PARTIAL) but NOT FAIL.
#   - Skips the gate if --no-verify flag is passed to `git push --no-verify`.
#
# This is a gate, not a jail. The override exists so the human stays in
# charge; the gate exists so that "I forgot to claim-check" doesn't happen
# silently.
#
# Mid-development: use `/vibe-verify` (fast keyword checker) instead.
# Ship-time: this hook runs `/vibe-claim-check`.

set -uo pipefail

# Skip if push was invoked with --no-verify.
for arg in "$@"; do
  if [ "$arg" = "--no-verify" ]; then
    exit 0
  fi
done

# Locate vibe-claim-check (project install takes priority over global install).
if   [ -x "./kit/bin/vibe-claim-check" ]; then
  VIBE_CLAIM="./kit/bin/vibe-claim-check"
elif [ -x "$HOME/.claude/vibe-kit/bin/vibe-claim-check" ]; then
  VIBE_CLAIM="$HOME/.claude/vibe-kit/bin/vibe-claim-check"
else
  echo "vibe-pre-push: vibe-claim-check not installed; skipping" >&2
  exit 0
fi

echo "vibe-pre-push: running vibe-claim-check (the ship gate)..."
echo

# Run claim-check, capture output for the report.
out_file="$(mktemp)"
"$VIBE_CLAIM" >"$out_file" 2>&1
rc=$?

# Print the report so the user sees what fired.
cat "$out_file"

echo
case "$rc" in
  0) echo "vibe-pre-push: PASS — pushing."; rm -f "$out_file"; exit 0 ;;
  1) echo "vibe-pre-push: FAIL — refusing push."
     echo "  fix: tests didn't pass. Run 'vibe-test' and fix the failing assertions."
     echo "  override: FAIL cannot be overridden; fix and re-push."
     rm -f "$out_file"
     exit 1 ;;
  2) if [ "${VIBE_SHIP_OVERRIDE:-}" = "1" ]; then
       echo "vibe-pre-push: BLOCK lifted by VIBE_SHIP_OVERRIDE=1 — pushing with documented human sign-off."
       rm -f "$out_file"
       exit 0
     fi
     echo "vibe-pre-push: BLOCK — refusing push."
     echo "  review: one or more ACs lack evidence. Open the Spec and run 'vibe-claim-check <slug>'."
     echo "  override: re-run with VIBE_SHIP_OVERRIDE=1 env var if the gaps are intentional."
     rm -f "$out_file"
     exit 1 ;;
  *) echo "vibe-pre-push: vibe-claim-check errored (rc=$rc); refusing push." >&2
     rm -f "$out_file"
     exit 1 ;;
esac