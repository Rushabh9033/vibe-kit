{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/vibe-kit/bin/hooks/post-edit-format.sh \"$CLAUDE_FILE_PATHS\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/vibe-kit/bin/hooks/guard-unsafe.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/vibe-kit/bin/hooks/session-end-handoff.sh"
          },
          {
            "type": "prompt",
            "prompt": "A session handoff stub was just written by `session-end-handoff.sh` (path is in its stderr). Open that stub, then read the template at ~/.claude/vibe-kit/templates/handoff.md and fill in: Goal, Done, In progress, Blocked, Files touched, Decisions made, Next steps, and Gotchas learned. If a section can't be determined, write 'unknown — left for next session'. Do not modify the metadata footer. Skip CHANGELOG.md appends unless the change was actually deployed (not just discussed)."
          }
        ]
      }
    ]
  }
}
